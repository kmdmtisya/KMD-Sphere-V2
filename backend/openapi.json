{
  "components": {
    "schemas": {
      "DashboardLayout": {
        "additionalProperties": false,
        "properties": {
          "hidden": {
            "items": {
              "enum": [
                "wealthSummary",
                "metrics",
                "insight",
                "goals"
              ],
              "type": "string"
            },
            "maxItems": 10,
            "title": "Hidden",
            "type": "array"
          },
          "order": {
            "items": {
              "enum": [
                "wealthSummary",
                "metrics",
                "insight",
                "goals"
              ],
              "type": "string"
            },
            "maxItems": 10,
            "title": "Order",
            "type": "array"
          }
        },
        "required": [
          "order"
        ],
        "title": "DashboardLayout",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LiveStatus": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "LiveStatus",
        "type": "object"
      },
      "MeResponse": {
        "properties": {
          "base_currency": {
            "title": "Base Currency",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "email_verified": {
            "title": "Email Verified",
            "type": "boolean"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "locale": {
            "title": "Locale",
            "type": "string"
          },
          "preferences": {
            "$ref": "#/components/schemas/Preferences"
          },
          "timezone": {
            "title": "Timezone",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "email_verified",
          "display_name",
          "base_currency",
          "locale",
          "timezone",
          "preferences",
          "created_at"
        ],
        "title": "MeResponse",
        "type": "object"
      },
      "Preferences": {
        "additionalProperties": false,
        "description": "UI preferences stored for the user. Unknown keys are rejected.",
        "properties": {
          "dashboard_layout": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DashboardLayout"
              },
              {
                "type": "null"
              }
            ]
          },
          "theme_mode": {
            "anyOf": [
              {
                "enum": [
                  "system",
                  "light",
                  "dark"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Theme Mode"
          }
        },
        "title": "Preferences",
        "type": "object"
      },
      "PreferencesUpdate": {
        "additionalProperties": false,
        "description": "PATCH body: any subset of the fields below. Omitted fields keep their value; sending null\nclears a UI preference.",
        "properties": {
          "base_currency": {
            "anyOf": [
              {
                "pattern": "^[A-Z]{3}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Base Currency"
          },
          "dashboard_layout": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DashboardLayout"
              },
              {
                "type": "null"
              }
            ]
          },
          "display_name": {
            "anyOf": [
              {
                "maxLength": 100,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "locale": {
            "anyOf": [
              {
                "pattern": "^[a-z]{2,3}([_-][A-Za-z0-9]{2,8})*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Locale"
          },
          "theme_mode": {
            "anyOf": [
              {
                "enum": [
                  "system",
                  "light",
                  "dark"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Theme Mode"
          },
          "timezone": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Timezone"
          }
        },
        "title": "PreferencesUpdate",
        "type": "object"
      },
      "ReadyStatus": {
        "properties": {
          "checks": {
            "additionalProperties": {
              "enum": [
                "ok",
                "failed"
              ],
              "type": "string"
            },
            "title": "Checks",
            "type": "object"
          },
          "status": {
            "enum": [
              "ready",
              "not_ready"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "ReadyStatus",
        "type": "object"
      },
      "RiskProfileCreate": {
        "additionalProperties": false,
        "properties": {
          "horizon_years": {
            "anyOf": [
              {
                "maximum": 100.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Horizon Years"
          },
          "risk_tolerance": {
            "enum": [
              "conservative",
              "balanced",
              "growth",
              "aggressive"
            ],
            "title": "Risk Tolerance",
            "type": "string"
          }
        },
        "required": [
          "risk_tolerance"
        ],
        "title": "RiskProfileCreate",
        "type": "object"
      },
      "RiskProfileOut": {
        "properties": {
          "assessed_at": {
            "format": "date-time",
            "title": "Assessed At",
            "type": "string"
          },
          "horizon_years": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Horizon Years"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "risk_tolerance": {
            "enum": [
              "conservative",
              "balanced",
              "growth",
              "aggressive"
            ],
            "title": "Risk Tolerance",
            "type": "string"
          },
          "source": {
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "id",
          "risk_tolerance",
          "horizon_years",
          "source",
          "assessed_at"
        ],
        "title": "RiskProfileOut",
        "type": "object"
      },
      "RiskProfileUpdate": {
        "additionalProperties": false,
        "description": "Corrects a self-assessment. Omitted fields keep their value.",
        "properties": {
          "horizon_years": {
            "anyOf": [
              {
                "maximum": 100.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Horizon Years"
          },
          "risk_tolerance": {
            "anyOf": [
              {
                "enum": [
                  "conservative",
                  "balanced",
                  "growth",
                  "aggressive"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Risk Tolerance"
          }
        },
        "title": "RiskProfileUpdate",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "description": "OIDC access token from the WealthSphere realm",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "contact": {
      "name": "WealthSphere",
      "url": "https://github.com/kmdmtisya/KMD-Sphere-V2"
    },
    "description": "Backend for the WealthSphere mobile apps. The backend is authoritative for all financial calculations. Money, quantities and rates are JSON strings. Errors use RFC 7807 problem+json and every response carries X-Correlation-ID.",
    "summary": "Portfolio and wealth intelligence API",
    "title": "WealthSphere API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/me": {
      "get": {
        "description": "The signed-in user, created on first sign-in.",
        "operationId": "get_me_api_v1_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Missing, invalid or expired access token"
          },
          "429": {
            "description": "Rate limit exceeded (docs/security.md, API protection)",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before retrying",
                "schema": {
                  "minimum": 1.0,
                  "type": "integer"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Get Me",
        "tags": [
          "identity"
        ]
      }
    },
    "/api/v1/me/preferences": {
      "patch": {
        "description": "Updates any subset of display name, base currency, locale, time zone and UI preferences.",
        "operationId": "update_preferences_api_v1_me_preferences_patch",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PreferencesUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Missing, invalid or expired access token"
          },
          "422": {
            "description": "Invalid preference values"
          },
          "429": {
            "description": "Rate limit exceeded (docs/security.md, API protection)",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before retrying",
                "schema": {
                  "minimum": 1.0,
                  "type": "integer"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Update Preferences",
        "tags": [
          "identity"
        ]
      }
    },
    "/api/v1/risk-profiles": {
      "get": {
        "description": "The signed-in user's risk assessments, newest first.",
        "operationId": "list_risk_profiles_api_v1_risk_profiles_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/RiskProfileOut"
                  },
                  "title": "Response List Risk Profiles Api V1 Risk Profiles Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Missing, invalid or expired access token"
          },
          "429": {
            "description": "Rate limit exceeded (docs/security.md, API protection)",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before retrying",
                "schema": {
                  "minimum": 1.0,
                  "type": "integer"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List Risk Profiles",
        "tags": [
          "identity"
        ]
      },
      "post": {
        "description": "Records a new risk self-assessment for the signed-in user.",
        "operationId": "add_risk_profile_api_v1_risk_profiles_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RiskProfileCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RiskProfileOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Missing, invalid or expired access token"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "description": "Rate limit exceeded (docs/security.md, API protection)",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before retrying",
                "schema": {
                  "minimum": 1.0,
                  "type": "integer"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Add Risk Profile",
        "tags": [
          "identity"
        ]
      }
    },
    "/api/v1/risk-profiles/{risk_profile_id}": {
      "get": {
        "description": "One of the signed-in user's risk assessments.",
        "operationId": "get_risk_profile_api_v1_risk_profiles__risk_profile_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "risk_profile_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Risk Profile Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RiskProfileOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Missing, invalid or expired access token"
          },
          "404": {
            "description": "No such risk profile for this user"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "description": "Rate limit exceeded (docs/security.md, API protection)",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before retrying",
                "schema": {
                  "minimum": 1,
                  "type": "integer"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Get Risk Profile",
        "tags": [
          "identity"
        ]
      },
      "patch": {
        "description": "Corrects one of the signed-in user's risk assessments.",
        "operationId": "update_risk_profile_api_v1_risk_profiles__risk_profile_id__patch",
        "parameters": [
          {
            "in": "path",
            "name": "risk_profile_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Risk Profile Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RiskProfileUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RiskProfileOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Missing, invalid or expired access token"
          },
          "404": {
            "description": "No such risk profile for this user"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "description": "Rate limit exceeded (docs/security.md, API protection)",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before retrying",
                "schema": {
                  "minimum": 1,
                  "type": "integer"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Update Risk Profile",
        "tags": [
          "identity"
        ]
      }
    },
    "/health/live": {
      "get": {
        "description": "Returns 200 while the process is running. Does not check dependencies.",
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiveStatus"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness probe",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "description": "Returns 200 when PostgreSQL and Redis are reachable, otherwise 503. Failure responses name the failing dependency but never reveal hosts or credentials.",
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyStatus"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyStatus"
                }
              }
            },
            "description": "A dependency is unavailable"
          }
        },
        "summary": "Readiness probe",
        "tags": [
          "health"
        ]
      }
    }
  },
  "servers": [
    {
      "description": "Local development",
      "url": "http://127.0.0.1:8000"
    }
  ],
  "tags": [
