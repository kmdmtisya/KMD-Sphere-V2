{
  "about": "Compound forecast golden vectors (P06-T01). Expected values come from closed-form formulas (lump sum, level and growing annuities at the equivalent per-period rate; docs/design/forecast-engine.md), computed independently of the engine's month-by-month loop at 60 digits and rounded half-up to the currency's minor units. The first two match published compound-interest tables.",
  "cases": [
    {
      "name": "textbook lump sum",
      "note": "10,000 at 5% compounded yearly for 10 years = 16,288.95 (published tables)",
      "input": {
        "currency": "USD",
        "compounding": "yearly",
        "contribution_frequency": "monthly",
        "initial": "10000.00",
        "contribution": "0",
        "annual_return_percent": "5",
        "years": 10
      },
      "expected": {
        "final_nominal": "16288.95",
        "final_real": "16288.95",
        "total_contributions": "10000.00",
        "total_growth": "6288.95"
      }
    },
    {
      "name": "textbook annuity",
      "note": "100 a month at 6% compounded monthly for 10 years = 16,387.93 (published tables)",
      "input": {
        "currency": "USD",
        "compounding": "monthly",
        "contribution_frequency": "monthly",
        "initial": "0",
        "contribution": "100.00",
        "annual_return_percent": "6",
        "years": 10
      },
      "expected": {
        "final_nominal": "16387.93",
        "final_real": "16387.93",
        "total_contributions": "12000.00",
        "total_growth": "4387.93"
      }
    },
    {
      "name": "zero rate",
      "note": "growth is exactly zero",
      "input": {
        "currency": "USD",
        "compounding": "monthly",
        "contribution_frequency": "monthly",
        "initial": "10000.00",
        "contribution": "500.00",
        "annual_return_percent": "0",
        "years": 20
      },
      "expected": {
        "final_nominal": "130000.00",
        "final_real": "130000.00",
        "total_contributions": "130000.00",
        "total_growth": "0.00"
      }
    },
    {
      "name": "negative rate",
      "note": "-10% a year: the value falls below what was paid in",
      "input": {
        "currency": "USD",
        "compounding": "yearly",
        "contribution_frequency": "yearly",
        "initial": "2000.00",
        "contribution": "100.00",
        "annual_return_percent": "-10",
        "years": 5
      },
      "expected": {
        "final_nominal": "1590.49",
        "final_real": "1590.49",
        "total_contributions": "2500.00",
        "total_growth": "-909.51"
