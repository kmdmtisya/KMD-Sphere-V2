# Copy to .env and replace every CHANGE_ME. Development values only; .env is git-ignored.
POSTGRES_USER=wealthsphere
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=wealthsphere
KEYCLOAK_DB=keycloak
REDIS_PASSWORD=CHANGE_ME
RABBITMQ_USER=wealthsphere
RABBITMQ_PASSWORD=CHANGE_ME
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
# Dev-only password for the realm's test users; must meet the realm policy (12+ chars, upper, lower, digit, symbol)
KEYCLOAK_TEST_USER_PASSWORD=CHANGE_ME

# Host ports (chosen to avoid clashes with common local services)
POSTGRES_PORT=5433
REDIS_PORT=6380
RABBITMQ_PORT=5673
RABBITMQ_UI_PORT=15673
KEYCLOAK_PORT=8081
KEYCLOAK_MGMT_PORT=9001

# Backend token verification. Must equal the `iss` claim of tokens exactly.
OIDC_ISSUER=http://127.0.0.1:8081/realms/wealthsphere

# Market-data provider keys (P08). Leave empty to disable the provider. Never commit real keys.
COINGECKO_API_KEY=
TWELVEDATA_API_KEY=

# AI providers (P10-T05, ADR-0017). Keys are server-side secrets, one per environment; never in the app.
# AI_PROVIDER=fake needs nothing. Model ids are configuration: there is no default.
AI_PROVIDER=fake
AI_FALLBACK_PROVIDER=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_OPENAI_MODEL=
AI_ANTHROPIC_MODEL=
# Days an AI conversation is kept after its last message (ADR-0017: 90).
AI_CONVERSATION_RETENTION_DAYS=90
# Assistant limits: questions per user per 24 hours and tool calls per question.
AI_QUESTIONS_PER_DAY=30
AI_MAX_TOOL_CALLS_PER_QUESTION=20
MARKET_DATA_MODE=real
