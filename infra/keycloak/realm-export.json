{
  "realm": "wealthsphere",
  "displayName": "WealthSphere (development)",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "verifyEmail": true,
  "rememberMe": false,
  "editUsernameAllowed": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 2592000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "passwordPolicy": "length(12) and maxLength(128) and upperCase(1) and lowerCase(1) and digits(1) and specialChars(1) and notUsername and notEmail and passwordHistory(5)",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "otpSupportedApplications": ["totpAppFreeOTPName", "totpAppGoogleName", "totpAppMicrosoftAuthenticatorName"],
  "roles": {
    "realm": [
      { "name": "user", "description": "A WealthSphere user. Granted to every account." },
      { "name": "support", "description": "Read-only support access (no financial data). Not granted by default." }
    ]
  },
  "defaultRole": {
    "name": "default-roles-wealthsphere",
    "composite": true,
    "composites": { "realm": ["user", "offline_access", "uma_authorization"] }
  },
  "requiredActions": [
    { "alias": "CONFIGURE_TOTP", "name": "Configure OTP", "providerId": "CONFIGURE_TOTP", "enabled": true, "defaultAction": false, "priority": 10, "config": {} },
    { "alias": "VERIFY_EMAIL", "name": "Verify Email", "providerId": "VERIFY_EMAIL", "enabled": true, "defaultAction": false, "priority": 50, "config": {} },
    { "alias": "UPDATE_PASSWORD", "name": "Update Password", "providerId": "UPDATE_PASSWORD", "enabled": true, "defaultAction": false, "priority": 30, "config": {} }
  ],
  "clients": [
    {
      "clientId": "wealthsphere-mobile",
      "name": "WealthSphere mobile app",
      "description": "Public client for the Android and iOS app: Authorization Code + PKCE (S256) only.",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "redirectUris": ["com.kmdmtisya.wealthsphere:/oauth2redirect"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "com.kmdmtisya.wealthsphere:/logout",
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false",
        "use.refresh.tokens": "true"
      },
      "defaultClientScopes": ["profile", "email", "roles", "basic"],
      "optionalClientScopes": ["offline_access"],
      "protocolMappers": [
        {
          "name": "audience-wealthsphere-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "wealthsphere-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "wealthsphere-api",
      "name": "WealthSphere API (audience only)",
      "description": "Represents the backend as a token audience. No login flows are enabled.",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [],
      "webOrigins": [],
      "attributes": {}
    }
  ],
  "users": [
    {
      "username": "alice@example.test",
      "email": "alice@example.test",
      "firstName": "Alice",
      "lastName": "Demo",
      "enabled": true,
      "emailVerified": true,
      "realmRoles": ["default-roles-wealthsphere"]
    },
    {
      "username": "bob@example.test",
      "email": "bob@example.test",
      "firstName": "Bob",
      "lastName": "Demo",
      "enabled": true,
      "emailVerified": true,
      "realmRoles": ["default-roles-wealthsphere"]
    },
    {
      "username": "mfa@example.test",
      "email": "mfa@example.test",
      "firstName": "Mfa",
      "lastName": "Demo",
      "enabled": true,
      "emailVerified": true,
      "requiredActions": ["CONFIGURE_TOTP"],
      "realmRoles": ["default-roles-wealthsphere"]
    }
  ]
}
